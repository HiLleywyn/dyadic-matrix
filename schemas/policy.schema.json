{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/HiLleywyn/dyadic-matrix/blob/main/schemas/policy.schema.json",
  "title": "dm local command policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "root",
    "commands"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "format": {
      "const": 1
    },
    "root": {
      "type": "string",
      "minLength": 1
    },
    "commands": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 8192
      }
    },
    "deny_commands": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 8192
      }
    },
    "executables": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "program",
          "prefix"
        ],
        "properties": {
          "program": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "prefix": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "string",
              "maxLength": 4096
            }
          }
        }
      }
    },
    "deny_executables": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "program",
          "prefix"
        ],
        "properties": {
          "program": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "prefix": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "string",
              "maxLength": 4096
            }
          }
        }
      }
    },
    "max_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300
    }
  }
}

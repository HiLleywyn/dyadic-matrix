{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/HiLleywyn/dyadic-matrix/blob/main/schemas/plan.schema.json",
  "title": "dm compiled plan",
  "type": "object",
  "required": [
    "language",
    "name",
    "source_sha256",
    "plan_sha256",
    "steps",
    "triggers",
    "inputs",
    "budgets",
    "expression_version",
    "imports"
  ],
  "properties": {
    "language": {
      "const": "dyadic.matrix/1"
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,63}$"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "type": "object",
        "required": [
          "key",
          "kind",
          "after",
          "line"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^n[1-9][0-9]*$"
          },
          "kind": {
            "enum": [
              "command",
              "fetch",
              "copy",
              "ask",
              "child",
              "generate",
              "value",
              "save",
              "wait",
              "print",
              "approval"
            ]
          },
          "after": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 512
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "expression": {
            "$ref": "#/$defs/expression"
          },
          "conditions": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/expression"
            }
          },
          "iterations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "line",
                "index",
                "limit"
              ],
              "properties": {
                "line": {
                  "type": "integer",
                  "minimum": 1
                },
                "index": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 31
                },
                "limit": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 32
                }
              }
            }
          },
          "calls": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "required": [
                "name",
                "line",
                "source_sha256"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "line": {
                  "type": "integer",
                  "minimum": 1
                },
                "source_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          }
        }
      }
    },
    "triggers": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "enum": [
              "event",
              "startup",
              "schedule",
              "date",
              "interval",
              "cron"
            ]
          }
        }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "budgets": {
      "type": "object",
      "required": [
        "steps"
      ],
      "properties": {
        "steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 512
        }
      }
    },
    "expression_version": {
      "const": "dyadic.matrix.values/1"
    },
    "imports": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    }
  },
  "$defs": {
    "expression": {
      "oneOf": [
        {
          "type": "array",
          "prefixItems": [
            {
              "const": "literal"
            },
            {
              "type": [
                "string",
                "number",
                "boolean",
                "null"
              ]
            }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "const": "ref"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "const": "index"
            },
            {
              "$ref": "#/$defs/expression"
            },
            {
              "$ref": "#/$defs/expression"
            }
          ],
          "minItems": 3,
          "maxItems": 3
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "const": "unary"
            },
            {
              "enum": [
                "+",
                "-",
                "not"
              ]
            },
            {
              "$ref": "#/$defs/expression"
            }
          ],
          "minItems": 3,
          "maxItems": 3
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "const": "binary"
            },
            {
              "enum": [
                "!=",
                "%",
                "*",
                "+",
                "-",
                "/",
                "<",
                "<=",
                "==",
                ">",
                ">=",
                "and",
                "or"
              ]
            },
            {
              "$ref": "#/$defs/expression"
            },
            {
              "$ref": "#/$defs/expression"
            }
          ],
          "minItems": 4,
          "maxItems": 4
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "const": "array"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/expression"
              },
              "maxItems": 256
            }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "const": "call"
            },
            {
              "const": "concat"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/expression"
              },
              "minItems": 2,
              "maxItems": 16
            }
          ],
          "minItems": 3,
          "maxItems": 3
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "const": "call"
            },
            {
              "const": "filter"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/expression"
              },
              "minItems": 2,
              "maxItems": 2
            }
          ],
          "minItems": 3,
          "maxItems": 3
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "const": "call"
            },
            {
              "const": "get"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/expression"
              },
              "minItems": 2,
              "maxItems": 3
            }
          ],
          "minItems": 3,
          "maxItems": 3
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "const": "call"
            },
            {
              "const": "group"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/expression"
              },
              "minItems": 2,
              "maxItems": 2
            }
          ],
          "minItems": 3,
          "maxItems": 3
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "const": "call"
            },
            {
              "const": "has"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/expression"
              },
              "minItems": 2,
              "maxItems": 2
            }
          ],
          "minItems": 3,
          "maxItems": 3
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "const": "call"
            },
            {
              "const": "json"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/expression"
              },
              "minItems": 1,
              "maxItems": 1
            }
          ],
          "minItems": 3,
          "maxItems": 3
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "const": "call"
            },
            {
              "const": "keys"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/expression"
              },
              "minItems": 1,
              "maxItems": 1
            }
          ],
          "minItems": 3,
          "maxItems": 3
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "const": "call"
            },
            {
              "const": "length"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/expression"
              },
              "minItems": 1,
              "maxItems": 1
            }
          ],
          "minItems": 3,
          "maxItems": 3
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "const": "call"
            },
            {
              "const": "map"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/expression"
              },
              "minItems": 2,
              "maxItems": 2
            }
          ],
          "minItems": 3,
          "maxItems": 3
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "const": "call"
            },
            {
              "const": "max"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/expression"
              },
              "minItems": 1,
              "maxItems": 1
            }
          ],
          "minItems": 3,
          "maxItems": 3
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "const": "call"
            },
            {
              "const": "min"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/expression"
              },
              "minItems": 1,
              "maxItems": 1
            }
          ],
          "minItems": 3,
          "maxItems": 3
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "const": "call"
            },
            {
              "const": "object"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/expression"
              },
              "minItems": 0,
              "maxItems": 32
            }
          ],
          "minItems": 3,
          "maxItems": 3
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "const": "call"
            },
            {
              "const": "set"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/expression"
              },
              "minItems": 3,
              "maxItems": 3
            }
          ],
          "minItems": 3,
          "maxItems": 3
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "const": "call"
            },
            {
              "const": "sort"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/expression"
              },
              "minItems": 1,
              "maxItems": 2
            }
          ],
          "minItems": 3,
          "maxItems": 3
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "const": "call"
            },
            {
              "const": "sum"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/expression"
              },
              "minItems": 1,
              "maxItems": 1
            }
          ],
          "minItems": 3,
          "maxItems": 3
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "const": "call"
            },
            {
              "const": "text"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/expression"
              },
              "minItems": 1,
              "maxItems": 1
            }
          ],
          "minItems": 3,
          "maxItems": 3
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "const": "call"
            },
            {
              "const": "unique"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/expression"
              },
              "minItems": 1,
              "maxItems": 1
            }
          ],
          "minItems": 3,
          "maxItems": 3
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "const": "call"
            },
            {
              "const": "values"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/expression"
              },
              "minItems": 1,
              "maxItems": 1
            }
          ],
          "minItems": 3,
          "maxItems": 3
        }
      ]
    }
  }
}

FROM python:3.13-slim-bookworm@sha256:a5a7017efc5969e00ae2b91c8eb0631049a569652aa4ffc4501769049ae45c72
RUN apt-get update && apt-get install -y --no-install-recommends binutils git && rm -rf /var/lib/apt/lists/*
COPY tools/build-requirements.txt /tmp/build-requirements.txt
RUN python -m pip install --no-cache-dir -r /tmp/build-requirements.txt
WORKDIR /src
